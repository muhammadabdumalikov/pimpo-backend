# Copy to .env and fill in values

# Server
PORT=3000

# Database
# Local dev / docker-compose default (matches docker-compose.yml credentials).
# When the API itself runs inside docker-compose, the host is `postgres`.
DATABASE_URL=postgresql://pimpo:pimpo@localhost:5432/pimpo

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=604800

# Redis cache + the BullMQ Telegram-notification queue both read these vars.
# Leave ALL of these unset to fall back to an in-memory cache AND direct (un-queued)
# notification sends — fine for local dev.
# Either set REDIS_URL directly, OR the discrete parts below.
# REDIS_URL=redis://default:password@host:6379
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
# Set to true for TLS providers (switches the scheme to rediss://).
REDIS_TLS=false
# Per-op timeout (ms). If Redis is slow/unreachable the op is abandoned and the
# request falls through to the DB, so the API never hangs. Default 1000.
# REDIS_OP_TIMEOUT_MS=1000

# Platform admin token — required (via X-Admin-Token header) to create/update/
# delete the global subscription plans. Leave unset to keep those endpoints
# fully locked (deny-by-default).
ADMIN_API_TOKEN=change-me-platform-admin-token

# Static platform-admin (super-admin) console credentials. POST /platform/login
# checks these and, on success, returns a JWT the console sends as its Bearer
# token (signed with JWT_SECRET, carrying role=platform-admin). Both must be set
# or login always fails. Independent of ADMIN_API_TOKEN above.
PLATFORM_ADMIN_LOGIN=admin
PLATFORM_ADMIN_PASSWORD=change-me-platform-admin-password

# S3-compatible storage (e.g. AWS S3, Hetzner Object Storage)
S3_BUCKET=pimpo
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_ENDPOINT=https://fsn1.your-objectstorage.com
# Optional: custom base URL for public links (default: S3_ENDPOINT/S3_BUCKET)
# S3_PUBLIC_BASE_URL=https://fsn1.your-objectstorage.com/pimpo

# Store (for public store API)
# STORE_BUSINESS_ID=your-business-id

# Barcode lookup — external fallback for GET /products/lookup.
# Open Food Facts (free, no key) is always used. To also query an official GS1
# provider (e.g. GS1 Uzbekistan / Verified by GS1), set the endpoint that accepts
# the GTIN as a `gtin` query param, plus an optional bearer token.
# GS1_API_URL=https://api.gs1uz.org/v1/product
# GS1_API_KEY=your-gs1-api-key
